#define name Apple Health Bridge
#define glyph heart
#define color red
#define version 18

#include 'actions/text'
#include 'actions/math'
#include 'actions/location'
#include 'actions/network'
#include 'actions/web'
#include 'actions/calendar'

#question haWebhook "粘贴 Apple Health Bridge 在 Home Assistant 中生成的完整 Webhook 地址" "http://homeassistant.local:8123/api/webhook/请替换为你的地址"

// Generic variants used so dictionaries and numbers keep their native types.
action 'setvalueforkey' setAnyValue(variable dictionary: 'WFDictionary', text key: 'WFDictionaryKey', variable value: 'WFDictionaryValue'): dictionary

@Choices = list(
    "步数",
    "步行与跑步距离",
    "活动能量",
    "锻炼时间",
    "站立小时",
    "心率",
    "静息心率",
    "血氧",
    "呼吸频率",
    "睡眠时长",
    "体重",
    "体脂率",
    "爬楼层数",
    "位置信息",
    "Wi-Fi 信息"
)
const PickedItems = chooseFromList(@Choices, "选择本次同步到 Home Assistant 的数据", true, true)
@Selected = getText(PickedItems)

@HealthData = {}
@LocationData = {}
@WifiData = {}
@HasLocation = false
@HasWifi = false

if @Selected contains "步数" {
    const StepsSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "steps"})
    if StepsSamples {
        const StepsMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StepsSamples}", "WFContentItemPropertyName": "Value"})
        const StepsValue = getNumbers(StepsMeasurements)
        if StepsValue {
            @Metric = {"unit": "steps", "name": "步数"}
            @Metric = setAnyValue(@Metric, "value", StepsValue)
            @HealthData = setAnyValue(@HealthData, "steps", @Metric)
        }
    }
}

if @Selected contains "步行与跑步距离" {
    const DistanceSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "walking_running_distance"})
    if DistanceSamples {
        const DistanceMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${DistanceSamples}", "WFContentItemPropertyName": "Value"})
        const DistanceKm = convertMeasurement(DistanceMeasurements, "Length", "km")
        const DistanceValue = getNumbers(DistanceKm)
        if DistanceValue {
            @Metric = {"unit": "km", "name": "步行与跑步距离"}
            @Metric = setAnyValue(@Metric, "value", DistanceValue)
            @HealthData = setAnyValue(@HealthData, "walking_running_distance", @Metric)
        }
    }
}

if @Selected contains "活动能量" {
    const EnergySamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "active_energy"})
    if EnergySamples {
        const EnergyMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${EnergySamples}", "WFContentItemPropertyName": "Value"})
        const EnergyKcal = convertMeasurement(EnergyMeasurements, "Energy", "kcal")
        const EnergyValue = getNumbers(EnergyKcal)
        if EnergyValue {
            @Metric = {"unit": "kcal", "name": "活动能量"}
            @Metric = setAnyValue(@Metric, "value", EnergyValue)
            @HealthData = setAnyValue(@HealthData, "active_energy", @Metric)
        }
    }
}

if @Selected contains "锻炼时间" {
    const ExerciseSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "exercise_minutes"})
    if ExerciseSamples {
        const ExerciseMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${ExerciseSamples}", "WFContentItemPropertyName": "Value"})
        const ExerciseMinutes = convertMeasurement(ExerciseMeasurements, "Duration", "minutes")
        const ExerciseValue = getNumbers(ExerciseMinutes)
        if ExerciseValue {
            @Metric = {"unit": "min", "name": "锻炼时间"}
            @Metric = setAnyValue(@Metric, "value", ExerciseValue)
            @HealthData = setAnyValue(@HealthData, "exercise_minutes", @Metric)
        }
    }
}

if @Selected contains "站立小时" {
    const StandSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "stand_hours"})
    if StandSamples {
        const StandMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StandSamples}", "WFContentItemPropertyName": "Value"})
        const StandHours = convertMeasurement(StandMeasurements, "Duration", "hours")
        const StandValue = getNumbers(StandHours)
        if StandValue {
            @Metric = {"unit": "h", "name": "站立小时"}
            @Metric = setAnyValue(@Metric, "value", StandValue)
            @HealthData = setAnyValue(@HealthData, "stand_hours", @Metric)
        }
    }
}

if @Selected contains "心率" {
    const HeartRateSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "heart_rate"})
    if HeartRateSamples {
        const HeartRateMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${HeartRateSamples}", "WFContentItemPropertyName": "Value"})
        const HeartRateValue = getNumbers(HeartRateMeasurements)
        if HeartRateValue {
            @Metric = {"unit": "bpm", "name": "心率"}
            @Metric = setAnyValue(@Metric, "value", HeartRateValue)
            @HealthData = setAnyValue(@HealthData, "heart_rate", @Metric)
        }
    }
}

if @Selected contains "静息心率" {
    const RestingHeartRateSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "resting_heart_rate"})
    if RestingHeartRateSamples {
        const RestingHeartRateMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${RestingHeartRateSamples}", "WFContentItemPropertyName": "Value"})
        const RestingHeartRateValue = getNumbers(RestingHeartRateMeasurements)
        if RestingHeartRateValue {
            @Metric = {"unit": "bpm", "name": "静息心率"}
            @Metric = setAnyValue(@Metric, "value", RestingHeartRateValue)
            @HealthData = setAnyValue(@HealthData, "resting_heart_rate", @Metric)
        }
    }
}

if @Selected contains "血氧" {
    const BloodOxygenSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "blood_oxygen"})
    if BloodOxygenSamples {
        const BloodOxygenMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${BloodOxygenSamples}", "WFContentItemPropertyName": "Value"})
        const BloodOxygenValue = getNumbers(BloodOxygenMeasurements)
        if BloodOxygenValue {
            @Metric = {"unit": "%", "name": "血氧"}
            @Metric = setAnyValue(@Metric, "value", BloodOxygenValue)
            @HealthData = setAnyValue(@HealthData, "blood_oxygen", @Metric)
        }
    }
}

if @Selected contains "呼吸频率" {
    const RespiratoryRateSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "respiratory_rate"})
    if RespiratoryRateSamples {
        const RespiratoryRateMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${RespiratoryRateSamples}", "WFContentItemPropertyName": "Value"})
        const RespiratoryRateValue = getNumbers(RespiratoryRateMeasurements)
        if RespiratoryRateValue {
            @Metric = {"unit": "breaths/min", "name": "呼吸频率"}
            @Metric = setAnyValue(@Metric, "value", RespiratoryRateValue)
            @HealthData = setAnyValue(@HealthData, "respiratory_rate", @Metric)
        }
    }
}

if @Selected contains "睡眠时长" {
    const SleepSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "sleep_duration"})
    if SleepSamples {
        const SleepDurations = rawAction("is.workflow.actions.properties.health.quantity", {
            "WFInput": "${SleepSamples}",
            "WFContentItemPropertyName": "Duration"
        })
        const SleepTotal = statistic("Sum", SleepDurations)
        const SleepHours = convertMeasurement(SleepTotal, "Duration", "hours")
        const SleepValue = getNumbers(SleepHours)
        if SleepValue {
            @Metric = {"unit": "h", "name": "睡眠时长"}
            @Metric = setAnyValue(@Metric, "value", SleepValue)
            @HealthData = setAnyValue(@HealthData, "sleep_duration", @Metric)
        }
    }
}

if @Selected contains "体重" {
    const WeightSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "weight"})
    if WeightSamples {
        const WeightMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${WeightSamples}", "WFContentItemPropertyName": "Value"})
        const WeightKg = convertMeasurement(WeightMeasurements, "Mass", "kg")
        const WeightValue = getNumbers(WeightKg)
        if WeightValue {
            @Metric = {"unit": "kg", "name": "体重"}
            @Metric = setAnyValue(@Metric, "value", WeightValue)
            @HealthData = setAnyValue(@HealthData, "weight", @Metric)
        }
    }
}

if @Selected contains "体脂率" {
    const BodyFatSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "body_fat_percentage"})
    if BodyFatSamples {
        const BodyFatMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${BodyFatSamples}", "WFContentItemPropertyName": "Value"})
        const BodyFatValue = getNumbers(BodyFatMeasurements)
        if BodyFatValue {
            @Metric = {"unit": "%", "name": "体脂率"}
            @Metric = setAnyValue(@Metric, "value", BodyFatValue)
            @HealthData = setAnyValue(@HealthData, "body_fat_percentage", @Metric)
        }
    }
}

if @Selected contains "爬楼层数" {
    const FloorsSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "floors_climbed"})
    if FloorsSamples {
        const FloorsMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${FloorsSamples}", "WFContentItemPropertyName": "Value"})
        const FloorsValue = getNumbers(FloorsMeasurements)
        if FloorsValue {
            @Metric = {"unit": "floors", "name": "爬楼层数"}
            @Metric = setAnyValue(@Metric, "value", FloorsValue)
            @HealthData = setAnyValue(@HealthData, "floors_climbed", @Metric)
        }
    }
}

if @Selected contains "位置信息" {
    const CurrentLocationValue = getCurrentLocation()
    const LatitudeValue = getLocationDetail(CurrentLocationValue, "Latitude")
    const LongitudeValue = getLocationDetail(CurrentLocationValue, "Longitude")
    const AltitudeValue = getLocationDetail(CurrentLocationValue, "Altitude")
    if LatitudeValue {
        if LongitudeValue {
            @LocationData = setAnyValue(@LocationData, "latitude", LatitudeValue)
            @LocationData = setAnyValue(@LocationData, "longitude", LongitudeValue)
            if AltitudeValue {
                @LocationData = setAnyValue(@LocationData, "altitude", AltitudeValue)
            }
            @HasLocation = true
        }
    }
}

if @Selected contains "Wi-Fi 信息" {
    const WifiNameValue = getWifiDetail("Network Name")
    const BssidValue = getWifiDetail("BSSID")
    if WifiNameValue {
        @WifiData = setAnyValue(@WifiData, "ssid", WifiNameValue)
        @HasWifi = true
    }
    if BssidValue {
        @WifiData = setAnyValue(@WifiData, "bssid", BssidValue)
    }
}

const NowValue = currentDate()
const TimestampValue = formatDate(NowValue, "ISO 8601")
@Payload = {"version": 1}
@Payload = setAnyValue(@Payload, "timestamp", TimestampValue)
@Payload = setAnyValue(@Payload, "health", @HealthData)

if @HasLocation {
    @Payload = setAnyValue(@Payload, "location", @LocationData)
}

if @HasWifi {
    @Payload = setAnyValue(@Payload, "wifi", @WifiData)
}

const ServerResponse = downloadURL(haWebhook)
showNotification("已同步到 Home Assistant", "Apple Health Bridge", false)
