#define name Apple Health Bridge
#define glyph heart
#define color red
#define version 18

#include 'actions/text'
#include 'actions/math'
#include 'actions/location'
#include 'actions/network'
#include 'actions/web'
#include 'actions/calendar'

#question haWebhook "粘贴 Apple Health Bridge 在 Home Assistant 中生成的完整 Webhook 地址" "http://homeassistant.local:8123/api/webhook/请替换为你的地址"

// 用一个包含全部支持类型的“查找健康样本”动作，在流程最前面集中触发健康授权。
// iOS 仍会显示系统授权页，用户必须在该页确认；快捷指令不能绕过系统授权。
const HealthAuthorization = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "authorize_all"})
const HAEndpoint = text(haWebhook)
const NowValue = currentDate()
const TodayDateKey = formatDate(NowValue, "Custom", "yyyy-MM-dd")
// The injector loads the persisted source before the discovery loop.
@SelectedSource = ""

// The injector turns this into a today/Day grouped Steps query.  Its Source
// details are used to build a one-time device picker, so no literal iPhone or
// Apple Watch name is required.
const DeviceSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "device_picker"})
@DeviceSourceMap = {}
for DeviceSourceItem in DeviceSamples {
    const DeviceSourceRaw = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${DeviceSourceItem}", "WFContentItemPropertyName": "Source"})
    const DeviceSourceNameText = getText(DeviceSourceRaw)
    const DeviceSourceName = trimWhitespace(DeviceSourceNameText)
    // Reconcile the persisted value with the current HealthKit spelling.
    // iOS may add formatting around a source name when it comes back from a
    // webhook response; using the name discovered from a live sample keeps
    // subsequent step/distance comparisons stable.
    if @SelectedSource {
        if @SelectedSource contains DeviceSourceName {
            @SelectedSource = DeviceSourceName
        }
    }
    @DeviceSourceMap = setValue(@DeviceSourceMap, "{DeviceSourceName}", "{DeviceSourceName}")
}
const DeviceChoice = chooseFromList(@DeviceSourceMap, "选择用于同步的健康数据设备", false, false)
const DeviceSourceChoiceText = getText(DeviceChoice)
const DeviceSourceText = trimWhitespace(DeviceSourceChoiceText)
@SelectedSource = DeviceSourceText

@Choices = list(
    "步数",
    "步行与跑步距离",
    "活动能量",
    "锻炼时间",
    "站立小时",
    "心率",
    "静息心率",
    "血氧",
    "呼吸频率",
    "睡眠时长",
    "体重",
    "体脂率",
    "爬楼层数",
    "位置信息",
    "Wi-Fi 信息"
)
const PickedItems = chooseFromList(@Choices, "选择本次同步到 Home Assistant 的数据", true, true)
@Selected = getText(PickedItems)

@HealthData = {}
@LocationData = {}
@WifiData = {}
@HasLocation = false
@HasWifi = false
@HasBssid = false

if @Selected contains "步数" {
    const StepsSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "steps"})
    if StepsSamples {
        @StepsTotal = 0
        @StepsMatched = false
        const StepsUnitSample = getFirstItem(StepsSamples)
        const StepsUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StepsUnitSample}", "WFContentItemPropertyName": "Unit"})
        for StepsItem in StepsSamples {
            const StepsSourceRaw = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StepsItem}", "WFContentItemPropertyName": "Source"})
            const StepsSourceNameText = getText(StepsSourceRaw)
            const StepsSourceName = trimWhitespace(StepsSourceNameText)
            if StepsSourceName == @SelectedSource {
                const StepsStartDate = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StepsItem}", "WFContentItemPropertyName": "Start Date"})
                const StepsDateKey = formatDate(StepsStartDate, "Custom", "yyyy-MM-dd")
                if StepsDateKey == TodayDateKey {
                    const StepsMeasurement = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StepsItem}", "WFContentItemPropertyName": "Value"})
                    const StepsNumbers = getNumbers(StepsMeasurement)
                    const StepsNumber = getFirstItem(StepsNumbers)
                    // Assign an explicit arithmetic expression here.  StepsNumber
                    // is a magic output from Get Numbers (not a typed number
                    // variable), so Cherri cannot lower `+=` to a Math action.
                    if StepsNumber {
                        @StepsTotal = @StepsTotal + StepsNumber
                        @StepsMatched = true
                    }
                }
            }
        }
        if @StepsMatched == 1 {
            const StepsValue = number(@StepsTotal)
            @Metric = {"name": "步数"}
            @Metric = setValue(@Metric, "unit", "{StepsUnit}")
            @Metric = setValue(@Metric, "value", "{StepsValue}")
            @HealthData = setValue(@HealthData, "steps", "{@Metric}")
        }
    }
}

if @Selected contains "步行与跑步距离" {
    const DistanceSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "walking_running_distance"})
    if DistanceSamples {
        @DistanceTotal = 0
        @DistanceMatched = false
        const DistanceUnitSample = getFirstItem(DistanceSamples)
        const DistanceUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${DistanceUnitSample}", "WFContentItemPropertyName": "Unit"})
        for DistanceItem in DistanceSamples {
            const DistanceSourceRaw = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${DistanceItem}", "WFContentItemPropertyName": "Source"})
            const DistanceSourceNameText = getText(DistanceSourceRaw)
            const DistanceSourceName = trimWhitespace(DistanceSourceNameText)
            if DistanceSourceName == @SelectedSource {
                const DistanceStartDate = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${DistanceItem}", "WFContentItemPropertyName": "Start Date"})
                const DistanceDateKey = formatDate(DistanceStartDate, "Custom", "yyyy-MM-dd")
                if DistanceDateKey == TodayDateKey {
                    const DistanceMeasurement = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${DistanceItem}", "WFContentItemPropertyName": "Value"})
                    const DistanceNumbers = getNumbers(DistanceMeasurement)
                    const DistanceNumber = getFirstItem(DistanceNumbers)
                    // See the steps accumulator above: force a native Math action
                    // instead of overwriting the accumulator with the last item.
                    if DistanceNumber {
                        @DistanceTotal = @DistanceTotal + DistanceNumber
                        @DistanceMatched = true
                    }
                }
            }
        }
        if @DistanceMatched == 1 {
            const DistanceValue = number(@DistanceTotal)
            @Metric = {"name": "步行与跑步距离"}
            @Metric = setValue(@Metric, "unit", "{DistanceUnit}")
            @Metric = setValue(@Metric, "value", "{DistanceValue}")
            @HealthData = setValue(@HealthData, "walking_running_distance", "{@Metric}")
        }
    }
}

if @Selected contains "活动能量" {
    const EnergySamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "active_energy"})
    if EnergySamples {
        const EnergyMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${EnergySamples}", "WFContentItemPropertyName": "Value"})
        const EnergyUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${EnergySamples}", "WFContentItemPropertyName": "Unit"})
        const EnergyValue = getNumbers(EnergyMeasurements)
        if EnergyValue {
            @Metric = {"name": "活动能量"}
            @Metric = setValue(@Metric, "unit", "{EnergyUnit}")
            @Metric = setValue(@Metric, "value", "{EnergyValue}")
            @HealthData = setValue(@HealthData, "active_energy", "{@Metric}")
        }
    }
}

if @Selected contains "锻炼时间" {
    const ExerciseSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "exercise_minutes"})
    if ExerciseSamples {
        const ExerciseMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${ExerciseSamples}", "WFContentItemPropertyName": "Value"})
        const ExerciseUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${ExerciseSamples}", "WFContentItemPropertyName": "Unit"})
        const ExerciseValue = getNumbers(ExerciseMeasurements)
        if ExerciseValue {
            @Metric = {"name": "锻炼时间"}
            @Metric = setValue(@Metric, "unit", "{ExerciseUnit}")
            @Metric = setValue(@Metric, "value", "{ExerciseValue}")
            @HealthData = setValue(@HealthData, "exercise_minutes", "{@Metric}")
        }
    }
}

if @Selected contains "站立小时" {
    const StandSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "stand_hours"})
    if StandSamples {
        const StandMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StandSamples}", "WFContentItemPropertyName": "Value"})
        const StandUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${StandSamples}", "WFContentItemPropertyName": "Unit"})
        const StandValue = getNumbers(StandMeasurements)
        if StandValue {
            @Metric = {"name": "站立时间"}
            @Metric = setValue(@Metric, "unit", "{StandUnit}")
            @Metric = setValue(@Metric, "value", "{StandValue}")
            @HealthData = setValue(@HealthData, "stand_hours", "{@Metric}")
        }
    }
}

if @Selected contains "心率" {
    const HeartRateSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "heart_rate"})
    if HeartRateSamples {
        const HeartRateMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${HeartRateSamples}", "WFContentItemPropertyName": "Value"})
        const HeartRateUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${HeartRateSamples}", "WFContentItemPropertyName": "Unit"})
        const HeartRateValue = getNumbers(HeartRateMeasurements)
        if HeartRateValue {
            @Metric = {"name": "心率"}
            @Metric = setValue(@Metric, "unit", "{HeartRateUnit}")
            @Metric = setValue(@Metric, "value", "{HeartRateValue}")
            @HealthData = setValue(@HealthData, "heart_rate", "{@Metric}")
        }
    }
}

if @Selected contains "静息心率" {
    const RestingHeartRateSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "resting_heart_rate"})
    if RestingHeartRateSamples {
        const RestingHeartRateMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${RestingHeartRateSamples}", "WFContentItemPropertyName": "Value"})
        const RestingHeartRateUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${RestingHeartRateSamples}", "WFContentItemPropertyName": "Unit"})
        const RestingHeartRateValue = getNumbers(RestingHeartRateMeasurements)
        if RestingHeartRateValue {
            @Metric = {"name": "静息心率"}
            @Metric = setValue(@Metric, "unit", "{RestingHeartRateUnit}")
            @Metric = setValue(@Metric, "value", "{RestingHeartRateValue}")
            @HealthData = setValue(@HealthData, "resting_heart_rate", "{@Metric}")
        }
    }
}

if @Selected contains "血氧" {
    const BloodOxygenSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "blood_oxygen"})
    if BloodOxygenSamples {
        const BloodOxygenMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${BloodOxygenSamples}", "WFContentItemPropertyName": "Value"})
        const BloodOxygenUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${BloodOxygenSamples}", "WFContentItemPropertyName": "Unit"})
        const BloodOxygenValue = getNumbers(BloodOxygenMeasurements)
        if BloodOxygenValue {
            @Metric = {"name": "血氧"}
            @Metric = setValue(@Metric, "unit", "{BloodOxygenUnit}")
            @Metric = setValue(@Metric, "value", "{BloodOxygenValue}")
            @HealthData = setValue(@HealthData, "blood_oxygen", "{@Metric}")
        }
    }
}

if @Selected contains "呼吸频率" {
    const RespiratoryRateSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "respiratory_rate"})
    if RespiratoryRateSamples {
        const RespiratoryRateMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${RespiratoryRateSamples}", "WFContentItemPropertyName": "Value"})
        const RespiratoryRateUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${RespiratoryRateSamples}", "WFContentItemPropertyName": "Unit"})
        const RespiratoryRateValue = getNumbers(RespiratoryRateMeasurements)
        if RespiratoryRateValue {
            @Metric = {"name": "呼吸频率"}
            @Metric = setValue(@Metric, "unit", "{RespiratoryRateUnit}")
            @Metric = setValue(@Metric, "value", "{RespiratoryRateValue}")
            @HealthData = setValue(@HealthData, "respiratory_rate", "{@Metric}")
        }
    }
}

if @Selected contains "睡眠时长" {
    const SleepSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "sleep_duration"})
    if SleepSamples {
        const SleepDurations = rawAction("is.workflow.actions.properties.health.quantity", {
            "WFInput": "${SleepSamples}",
            "WFContentItemPropertyName": "Duration"
        })
        const SleepTotal = statistic("Sum", SleepDurations)
        // “持续时间”汇总后的输出是秒数，不是“测量”对象；直接换算可避免文本转测量错误。
        const SleepHours = SleepTotal / 3600
        const SleepValue = getNumbers(SleepHours)
        if SleepValue {
            @Metric = {"unit": "h", "name": "睡眠时长"}
            @Metric = setValue(@Metric, "value", "{SleepValue}")
            @HealthData = setValue(@HealthData, "sleep_duration", "{@Metric}")
        }
    }
}

if @Selected contains "体重" {
    const WeightSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "weight"})
    if WeightSamples {
        const WeightMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${WeightSamples}", "WFContentItemPropertyName": "Value"})
        const WeightUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${WeightSamples}", "WFContentItemPropertyName": "Unit"})
        const WeightValue = getNumbers(WeightMeasurements)
        if WeightValue {
            @Metric = {"name": "体重"}
            @Metric = setValue(@Metric, "unit", "{WeightUnit}")
            @Metric = setValue(@Metric, "value", "{WeightValue}")
            @HealthData = setValue(@HealthData, "weight", "{@Metric}")
        }
    }
}

if @Selected contains "体脂率" {
    const BodyFatSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "body_fat_percentage"})
    if BodyFatSamples {
        const BodyFatMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${BodyFatSamples}", "WFContentItemPropertyName": "Value"})
        const BodyFatUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${BodyFatSamples}", "WFContentItemPropertyName": "Unit"})
        const BodyFatValue = getNumbers(BodyFatMeasurements)
        if BodyFatValue {
            @Metric = {"name": "体脂率"}
            @Metric = setValue(@Metric, "unit", "{BodyFatUnit}")
            @Metric = setValue(@Metric, "value", "{BodyFatValue}")
            @HealthData = setValue(@HealthData, "body_fat_percentage", "{@Metric}")
        }
    }
}

if @Selected contains "爬楼层数" {
    const FloorsSamples = rawAction("is.workflow.actions.filter.health.quantity", {"AHBMetric": "floors_climbed"})
    if FloorsSamples {
        const FloorsMeasurements = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${FloorsSamples}", "WFContentItemPropertyName": "Value"})
        const FloorsUnit = rawAction("is.workflow.actions.properties.health.quantity", {"WFInput": "${FloorsSamples}", "WFContentItemPropertyName": "Unit"})
        const FloorsValue = getNumbers(FloorsMeasurements)
        if FloorsValue {
            @Metric = {"name": "爬楼层数"}
            @Metric = setValue(@Metric, "unit", "{FloorsUnit}")
            @Metric = setValue(@Metric, "value", "{FloorsValue}")
            @HealthData = setValue(@HealthData, "floors_climbed", "{@Metric}")
        }
    }
}

if @Selected contains "位置信息" {
    const CurrentLocationValue = getCurrentLocation()
    const LatitudeValue = getLocationDetail(CurrentLocationValue, "Latitude")
    const LongitudeValue = getLocationDetail(CurrentLocationValue, "Longitude")
    const AltitudeValue = getLocationDetail(CurrentLocationValue, "Altitude")
    if LatitudeValue {
        if LongitudeValue {
            @LocationData = setValue(@LocationData, "latitude", "{LatitudeValue}")
            @LocationData = setValue(@LocationData, "longitude", "{LongitudeValue}")
            if AltitudeValue {
                @LocationData = setValue(@LocationData, "altitude", "{AltitudeValue}")
            }
            @HasLocation = true
        }
    }
}

if @Selected contains "Wi-Fi 信息" {
    const WifiNameValue = getWifiDetail("Network Name")
    if WifiNameValue {
        @WifiData = setValue(@WifiData, "ssid", "{WifiNameValue}")
        @HasWifi = true
        // BSSID is unavailable on cellular connections and can abort the
        // Shortcut before the public webhook request. Only query it after a
        // network name confirms that Wi-Fi is actually connected.
        const BssidValue = getWifiDetail("BSSID")
        if BssidValue {
            @WifiData = setValue(@WifiData, "bssid", "{BssidValue}")
            @HasBssid = true
        }
    }
}

const TimestampValue = formatDate(NowValue, "ISO 8601")
@Payload = {"version": 1}
@Payload = setValue(@Payload, "timestamp", "{TimestampValue}")
@Payload = setValue(@Payload, "health", "{@HealthData}")

if @HasLocation == 1 {
    @Payload = setValue(@Payload, "location", "{@LocationData}")
}

if @HasWifi == 1 {
    @Payload = setValue(@Payload, "wifi", "{@WifiData}")
}

const PayloadText = getText(@Payload)
const ServerResponse = downloadURL(HAEndpoint)
// Send optional Wi-Fi fields separately.  Empty Get Wi-Fi Detail outputs are
// not valid form values on iOS, so they must never be included in the main
// request when the phone is off Wi-Fi.
if @HasWifi == 1 {
    const WifiSSIDResponse = downloadURL(HAEndpoint)
}
if @HasBssid == 1 {
    const WifiBSSIDResponse = downloadURL(HAEndpoint)
}
const ResponseText = getText(ServerResponse)
showNotification("{ResponseText}", "Apple Health Bridge 响应", false)
